<Project Sdk="Microsoft.NET.Sdk">

  <!--
    可选：针对「某个具体服务器」的 TShock 版本重新编译 NurseHeal。

    为什么需要：
      仓库 template.targets 固定引用 NuGet 的 TShock 6.1.0，而目标服可能是
      6.2.1.0 等其它版本。跨版本虽通常能加载，但存在 MissingMethodException 风险，
      用服务器自带程序集编译最稳妥。

    怎么用：
      dotnet build _deploy/NurseHeal.Deploy.csproj -c Release ^
        -p:TShockRefDir=<服务器程序集目录>

      该目录下需有 TShockAPI.dll / TerrariaServer.dll / OTAPI.dll / ModFramework.dll
      （TShockAPI.dll 通常在上层 ServerPlugins，其余在 bin）。

    不传 TShockRefDir 时：
      本工程直接编译失败并给出提示 —— 请改用仓库标准工程：
        dotnet build src/NurseHeal/NurseHeal.csproj -c Release
      （那条路径走 template.targets + NuGet TShock 6.1.0，适合常规开发）

    注意：本工程刻意不 Import template.targets —— 它写死了 PackageReference TShock 6.1.0
    （IncludeAssets=compile），会把 6.1 程序集强行塞进编译引用，导致这里指定的 6.2.1 失效。
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NurseHeal</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <!-- 产物与其它插件一致，落到仓库根目录 out/Release -->
    <OutputPath>..\out\$(Configuration)</OutputPath>
    <!-- 本工程只编译 NurseHeal 自己的源码，不自动纳入 Shared 等目录 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\NurseHeal\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TShockRefDir)' == ''">
    <None Include="$(MSBuildProjectFullPath)" />
  </ItemGroup>

  <!-- 只有指定了服务器程序集目录才建立引用；否则下面 Target 会报错提示 -->
  <ItemGroup Condition="'$(TShockRefDir)' != ''">
    <Reference Include="TShockAPI">
      <HintPath>$(TShockRefDir)\TShockAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TerrariaServer">
      <HintPath>$(TShockRefDir)\TerrariaServer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OTAPI">
      <HintPath>$(TShockRefDir)\OTAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ModFramework">
      <HintPath>$(TShockRefDir)\ModFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RequireTShockRefDir" BeforeTargets="ResolveReferences" Condition="'$(TShockRefDir)' == ''">
    <Error Text="未指定 TShockRefDir。请传入服务器程序集目录，例如：&#10;  dotnet build _deploy/NurseHeal.Deploy.csproj -c Release -p:TShockRefDir=/path/to/server/bin&#10;常规开发请改用：dotnet build src/NurseHeal/NurseHeal.csproj -c Release" />
  </Target>

</Project>
